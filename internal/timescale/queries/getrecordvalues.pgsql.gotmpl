-- The record values of several columns of one table over the window [$1, $2),
-- in a single scan: max for a record high, min for a record low. Aggregates
-- skip NULL readings, so each value is a real observation, and a column with
-- no reading in the window yields NULL.
SELECT
{{- range $i, $e := .Extremes}}
    {{if $i}},{{end}}{{$e.Agg}}({{$e.Column}})::float8
{{- end}}
FROM
    sensors.{{.Table}}
WHERE
    "time" >= $1
    AND "time" < $2
    {{if .SerialFiltered}}AND serial_number IN ('{{.Serial}}'){{end}}
    {{if .ExcludeSpinup}}AND NOT spinup{{end}}
